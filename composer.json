{
    "name": "enriquejlicona/js-localization",
    "description": "Laravel package to provide localizations to the Javascript code.",
    "keywords": ["laravel", "javascript", "localization", "translation", "messages"],
    "license": "MIT",
    "authors": [
        {
            "name": "Andy Wermke",
            "email": "andy@dev.next-step-software.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "6.*|7.*|8.*|9.*|10.*|11.*|12.*"
    },
    "require-dev": {
        "mockery/mockery": "~1.0",
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "JsLocalization\\": "src/"
        }
    },
    "autoload-dev": {
        "classmap": [
            "tests/TestCase.php"
        ]
    },
    "extra": {
        "component": "package",
        "frameworks": ["Laravel 12"]
    },
    "minimum-stability": "stable"
}
